<Template>
  <WidgetGroup>
    <ObjectName>DeckRow_1_KeyVinylFx</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,max</SizePolicy>
    <Children>

      <Template src="skins:LateNight/fx/assign_buttons.xml"/>

      <WidgetGroup><Size>2f,0min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>ExpandingBottomBorder</ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <MinimumSize>2,1</MinimumSize>
        <Children/>
      </WidgetGroup>

      <Template src="skins:LateNight/decks/vinyl_controls.xml"/>

      <WidgetGroup>
        <ObjectName>ExpandingBottomBorder</ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <MinimumSize>2,1</MinimumSize>
      </WidgetGroup>

      <WidgetGroup><Size>2f,0me</Size></WidgetGroup>

      <WidgetGroup>
        <SizePolicy>me,min</SizePolicy>
        <!-- Andy CP75: was 111, which silently clipped CP72's wider offset
             label back to the old width - the whole point of the "+2" was
             lost. The cap only limits; with the offset label switched off the
             children still add up to 111, so stock LateNight is unchanged. -->
        <MaximumSize>186,</MaximumSize>
        <Layout>vertical</Layout>
        <Children>
          <SingletonContainer>
            <ObjectName>KeyControls<Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_key_controls</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
  </WidgetGroup><!-- DeckRow_1_KeyVinylFx -->
</Template>
