<Template>
  <WidgetGroup>
    <!-- This extra wrapper with 'ignore' size policy allows to
      shrink the library to zero height, while the inner LibraryContainer
      expands to fill the available vertical space. -->
    <SizePolicy>me,i</SizePolicy>
    <Layout>vertical</Layout>
    <Children>
      <!--
      **********************************************
      Library / Preview Deck / Search / Tree view
      **********************************************
      -->
      <WidgetGroup>
        <ObjectName>LibraryContainer</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <!-- CP9: vertical stack = [sidebar | library | playlist pane] over the
               full-width Auto DJ strip. Both extra panes fully collapsible. -->
          <Splitter>
            <ObjectName>LibraryVSplitter</ObjectName>
            <SizePolicy>me,me</SizePolicy>
            <Orientation>vertical</Orientation>
            <!-- Driven by the including skin: a skin that switches off the
                 side pane below (ShowLibrarySidePane=false) has one child here
                 instead of two, so it needs its own sizes and its own stored
                 split-size key. -->
            <SplitSizes><Variable name="LibraryVSplitSizes"/></SplitSizes>
            <SplitSizesConfigKey>[Skin],<Variable name="LibraryVSplitSizesKey"/></SplitSizesConfigKey>
            <Collapsible><Variable name="LibraryVSplitCollapsible"/></Collapsible>
            <!-- CP70: opt-in per including skin (AndyVideo sets it to "true").
                 Undefined = empty = off, so the stock skins keep the size-hint
                 floor they have always had. See WSplitter::setup(). -->
            <FreeResize><Variable name="LibraryFreeResize"/></FreeResize>
            <Children>

          <Splitter>
            <ObjectName>LibrarySplitter</ObjectName>
            <SizePolicy>me,me</SizePolicy>
            <!-- CP74: driven by the including skin, like LibraryVSplitter
                 above - a skin that switches off the inline Auto DJ pane has
                 two children here, not three, and its defaults have to match
                 or Mixxx drops them (and warns) on a fresh profile. -->
            <SplitSizes><Variable name="LibrarySplitSizes"/></SplitSizes>
            <SplitSizesConfigKey>[Skin],<Variable name="LibrarySplitSizesKey"/></SplitSizesConfigKey>
            <Collapsible><Variable name="LibrarySplitCollapsible"/></Collapsible>
            <!-- CP70: this is the splitter Andy's "I want the middle library
                 table to get narrower" is about. LibSidebarContainer keeps its
                 explicit 100 px floor, the table and the Auto DJ pane lose
                 theirs. Opt-in, see LibraryVSplitter above. -->
            <FreeResize><Variable name="LibraryFreeResize"/></FreeResize>
            <!-- CP74: opt-in per skin ("1,0" in AndyVideo, which has two
                 children here because it switches off the inline Auto DJ pane).
                 Holds the sidebar - preview deck, search box, tree, cover - at
                 a constant width when the window or the presenter column is
                 resized, instead of letting it take its proportional share.
                 The track table absorbs the change; dragging this splitter's
                 own handle still resizes the sidebar and sets the new width. -->
            <KeepSize><Variable name="LibraryKeepSize"/></KeepSize>
            <Children>

              <WidgetGroup>
                <ObjectName>LibSidebarContainer</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>min,me</SizePolicy>
                <MinimumSize>100,</MinimumSize>
                <Children>

                  <!-- CP74: the preview deck became a singleton so it can be
                       moved to other slots (AndyVideo offers a few; see
                       decks/preview_slot.xml). It is DEFINED here, at the spot
                       it has always been drawn, and the slot right below is
                       position 0 - so a skin that does not know about any of
                       this gets exactly the old picture: position defaults to
                       0, the deck stays in the sidebar. -->
                  <SingletonDefinition>
                    <ObjectName>PreviewDeckSingleton</ObjectName>
                    <Children>
                      <Template src="skins:LateNight/decks/preview_deck.xml"/>
                    </Children>
                  </SingletonDefinition>

                  <Template src="skins:LateNight/decks/preview_slot.xml">
                    <SetVariable name="PreviewPos">0</SetVariable>
                  </Template>

                  <WidgetGroup><!--SearchBox + Library expand toggle -->
                    <Layout>horizontal</Layout>
                    <SizePolicy>min,max</SizePolicy>
                    <Children>

                      <WidgetGroup>
                        <ObjectName>SearchLineBox</ObjectName>
                        <Layout>horizontal</Layout>
                        <SizePolicy>min,max</SizePolicy>
                        <Children>
                          <SearchBox></SearchBox>
                        </Children>
                      </WidgetGroup>

                      <WidgetGroup>
                        <ObjectName>LibExpandBox</ObjectName>
                        <Layout>vertical</Layout>
                        <Children>
                          <Template src="skins:LateNight/controls/button_2state.xml">
                            <SetVariable name="TooltipId">maximize_library</SetVariable>
                            <SetVariable name="ObjectName">LibExpand</SetVariable>
                            <SetVariable name="Size">18f,18me</SetVariable>
                            <SetVariable name="ConfigKey">[Skin],show_maximized_library</SetVariable>
                          </Template>
                        </Children>
                      </WidgetGroup><!-- LibExpandBox -->
                    </Children>
                  </WidgetGroup><!--SearchBox + Library expand toggle -->

                  <WidgetGroup>
                    <ObjectName>SearchTreeSpacer</ObjectName>
                    <Layout>horizontal</Layout>
                    <Children/>
                  </WidgetGroup>

                  <Splitter>
                    <ObjectName>SidebarCoverSplitter</ObjectName>
                    <Size>me,me</Size>
                    <SplitSizes>1,1</SplitSizes>
                    <SplitSizesConfigKey>[Skin],coverArt_splitsize</SplitSizesConfigKey>
                    <Orientation>vertical</Orientation>
                    <Collapsible>0,0</Collapsible>
                    <Children>
                      <!--Library Tree View-->
                      <WidgetGroup>
                        <ObjectName>SidebarBox</ObjectName>
                        <Layout>vertical</Layout>
                        <Children>
                          <LibrarySidebar></LibrarySidebar>
                        </Children>
                      </WidgetGroup>
                      <!--Cover Art-->
                      <WidgetGroup>
                        <ObjectName>AlignCenter</ObjectName>
                        <Layout>vertical</Layout>
                        <Children>
                          <CoverArt>
                            <SizePolicy>me,me</SizePolicy>
                            <MinimumSize>40,40</MinimumSize>
                          </CoverArt>
                        </Children>
                        <Connection>
                          <ConfigKey persist="true">[Skin],show_library_coverart</ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </WidgetGroup><!--Cover Art-->
                    </Children>
                  </Splitter><!-- SidebarCoverSplitter -->

                </Children>
              </WidgetGroup><!-- LibSidebarContainer -->

              <!-- Library Table-->
              <Library>
                <ShowButtonText>false</ShowButtonText>
                <TrackTableBackgroundColorOpacity>0.175</TrackTableBackgroundColorOpacity>
                <!-- Colors for the render modes of the Overview column -->
                <!-- For the overview column we only set the signal color,
                     other colors are the defaults. -->
                <SignalColor><Variable name="SignalColor_12"/></SignalColor>
              </Library>

              <!-- CP20 swap: Auto DJ now lives in the right column beside the
                   main track table (it needs little width, so the right side
                   suits it). Drag the splitter handle fully right to collapse.
                   CP65: optional <Enabled> lets a skin that repositions this
                   pane itself (AndyVideo's classic_autodj_bottom toggle)
                   switch off the inline copy, same mechanism as
                   AndysPlaylistPane's ShowLibrarySidePane below. Undefined
                   variable (every other skin) keeps it shown. -->
              <AndysAutoDJPane>
                <ShowButtonText>false</ShowButtonText>
                <TrackTableBackgroundColorOpacity>0.175</TrackTableBackgroundColorOpacity>
                <Enabled><Variable name="ShowAutoDJPaneInline"/></Enabled>
              </AndysAutoDJPane>

            </Children>
          </Splitter><!-- LibrarySplitter -->

              <!-- CP20 swap: Andy's second playlist pane is now the full-width
                   strip below the library (filled via sidebar right-click
                   "Open in side pane"). Drag the handle fully down to collapse. -->
              <!-- Skins that inherit this template and already show a pane of
                   their own (AndyVideo/AndyStems, PresenterZone) switch this
                   one off with <SetVariable name="ShowLibrarySidePane">false
                   </SetVariable> on their <Template> node. Undefined = shown. -->
              <AndysPlaylistPane>
                <Enabled><Variable name="ShowLibrarySidePane"/></Enabled>
                <TrackTableBackgroundColorOpacity>0.175</TrackTableBackgroundColorOpacity>
              </AndysPlaylistPane>

            </Children>
          </Splitter><!-- LibraryVSplitter -->

        </Children>
      </WidgetGroup><!-- LibraryContainer -->
    </Children>
  </WidgetGroup>
</Template>
