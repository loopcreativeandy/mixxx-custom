<!--
  Andy Video — slim one-line track info for one deck.
  Variables: Group (e.g. [Channel1]), ChanNum (e.g. 1).

  Deliberately ONE row: the top of the frame belongs to the waveforms, so this
  strip lives in the left control column instead. Carries the things a viewer
  wants and Mixxx does not otherwise show: Andy's grouping (energy) and comment
  (the machine tag block). Both are plain Track Q_PROPERTYs — no C++.
-->
<Template>
  <WidgetGroup>
    <ObjectName>NowPlayingLine</ObjectName>
    <Layout>horizontal</Layout>
    <Size>100me,26f</Size>
    <Children>

      <TrackProperty>
        <ObjectName>NowPlayingTitle</ObjectName>
        <TooltipId>track_title</TooltipId>
        <Property>title</Property>
        <Size>32me,24f</Size>
        <Alignment>left</Alignment>
        <Elide>right</Elide>
        <Channel><Variable name="ChanNum"/></Channel>
      </TrackProperty>

      <TrackProperty>
        <ObjectName>NowPlayingArtist</ObjectName>
        <TooltipId>track_artist</TooltipId>
        <Property>artist</Property>
        <Size>22me,24f</Size>
        <Alignment>left</Alignment>
        <Elide>right</Elide>
        <Channel><Variable name="ChanNum"/></Channel>
      </TrackProperty>

      <Key>
        <ObjectName>NowPlayingKey</ObjectName>
        <TooltipId>track_key</TooltipId>
        <Group><Variable name="Group"/></Group>
        <Size>52f,24f</Size>
        <Alignment>center</Alignment>
        <Elide>right</Elide>
        <Connection>
          <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
        </Connection>
      </Key>

      <Number>
        <ObjectName>NowPlayingBpm</ObjectName>
        <TooltipId>visual_bpm</TooltipId>
        <Size>62f,24f</Size>
        <Alignment>center</Alignment>
        <NumberOfDigits>1</NumberOfDigits>
        <Connection>
          <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
        </Connection>
      </Number>

      <TrackProperty>
        <ObjectName>NowPlayingEnergy</ObjectName>
        <Property>grouping</Property>
        <Size>96f,24f</Size>
        <Alignment>center</Alignment>
        <Elide>right</Elide>
        <Channel><Variable name="ChanNum"/></Channel>
      </TrackProperty>

      <TrackProperty>
        <ObjectName>NowPlayingTags</ObjectName>
        <TooltipId>track_comment</TooltipId>
        <Property>comment</Property>
        <Size>46me,24f</Size>
        <Alignment>left</Alignment>
        <Elide>right</Elide>
        <Channel><Variable name="ChanNum"/></Channel>
      </TrackProperty>

    </Children>
  </WidgetGroup>
</Template>
